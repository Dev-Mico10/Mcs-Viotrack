<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DDF1FF">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/loginbackground"
        android:contentDescription="Background image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Light Blue Overlay -->
    <View
        android:id="@+id/blueOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#B3DDF1FF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Main Content -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="364dp"
        android:layout_height="382dp"
        android:layout_margin="16dp"
        android:background="#F5FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <!-- Title -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="VIOLATION REPORT"
            android:textColor="#164B83"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Student Discipline Management System"
            android:textColor="#50769B"
            android:textSize="14sp" />

        <!-- Generate Violation Report -->
        <Button
            android:id="@+id/btnGenerateViolationReport"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#378AD6"
            android:drawablePadding="8dp"
            android:text="Generate Violation Report"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <!-- Compile Student Records -->
        <Button
            android:id="@+id/btnCompileStudentsRecord"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="22dp"
            android:backgroundTint="#2469AC"
            android:text="Compile Students Record"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <!-- Status Card -->
        <LinearLayout
            android:id="@+id/reportStatusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D9EDFF"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvReportStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Report Status"
                android:textColor="#164B83"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReportMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="No report generated yet."
                android:textColor="#50769B"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="116dp"
        android:layout_height="113dp"
        app:srcCompat="@drawable/mcsviotracklogo"
        tools:layout_editor_absoluteX="288dp"
        tools:layout_editor_absoluteY="611dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
